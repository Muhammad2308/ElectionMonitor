VITE_API_URL=http://localhost:8000
VITE_APP_NAME=ElectWatch

# Google Identity Services client ID (OAuth 2.0 Client ID, "Web application"
# type, from https://console.cloud.google.com/apis/credentials). Public —
# safe to expose to the browser. Leave unset to hide "Continue with Google".
# Must match GOOGLE_CLIENT_ID in the backend's .env for token verification.
VITE_GOOGLE_CLIENT_ID=
